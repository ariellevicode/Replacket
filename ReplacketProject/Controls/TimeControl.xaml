<UserControl x:Class="ReplacketProject.Controls.TimeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <materialDesign:Card Margin="0,0,0,6" 
                         UniformCornerRadius="8" 
                         Padding="10,8"
                         Background="{DynamicResource MaterialDesignPaper}">

        <StackPanel>
            
            <Grid Margin="0,0,0,4">
                <TextBlock Text="time (in milliseconds):" 
               FontSize="12" 
               FontWeight="SemiBold" 
               VerticalAlignment="Center"
               Foreground="{DynamicResource MaterialDesignBody}"/>

                <StackPanel Orientation="Horizontal" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Center">

                    <TextBlock Text="diff" 
                   FontSize="11" 
                   VerticalAlignment="Center" 
                   Margin="0,0,4,0" 
                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>

                    
                    <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                      IsChecked="{Binding IsFixedDelay, Mode=TwoWay}"
                      Cursor="Hand">
                        <ToggleButton.LayoutTransform>
                            <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                        </ToggleButton.LayoutTransform>
                    </ToggleButton>

                    <TextBlock Text="fixed" 
                   FontSize="11" 
                   VerticalAlignment="Center" 
                   Margin="4,0,0,0" 
                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                </StackPanel>
            </Grid>

           
            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Height="32" 
                    Background="{DynamicResource MaterialDesignTextFieldBoxBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NumberTextBox"
                             Grid.Column="0"
                             Text="{Binding DelayTime}"
                             FontSize="13"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             BorderThickness="0"
                             Background="Transparent"/>

                    <Border Grid.Column="1" 
                            BorderBrush="{DynamicResource MaterialDesignDivider}" 
                            BorderThickness="1,0,0,0">
                        <Grid Width="28">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    Command="{Binding IncrementCommand}" 
                                    CommandParameter="Delay"
                                    Padding="0" Margin="0"
                                    Height="15" Width="27"
                                    Cursor="Hand">
                                <materialDesign:PackIcon Kind="Plus" Width="10" Height="10"/>
                            </Button>

                            <Separator Grid.Row="0" 
                                       VerticalAlignment="Bottom" 
                                       Margin="0" 
                                       Background="{DynamicResource MaterialDesignDivider}"/>

                            <Button Grid.Row="1"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    Command="{Binding DecrementCommand}" 
                                    CommandParameter="Delay"
                                    Padding="0" Margin="0"
                                    Height="15" Width="27"
                                    Cursor="Hand">
                                <materialDesign:PackIcon Kind="Minus" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

    </materialDesign:Card>
</UserControl>