<UserControl x:Class="ReplacketProject.Controls.FileUploadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">

    <materialDesign:Card Margin="0,0,0,6" 
                         UniformCornerRadius="8" 
                         Padding="10"
                         Background="{DynamicResource MaterialDesignPaper}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- File Path Input & Browse Button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="FilePathTextBox" 
                         Grid.Column="0"
                         Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="File Path"
                         materialDesign:HintAssist.HelperText="Select or paste full path"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         FontSize="12"
                         Padding="8,6"
                         VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Command="{Binding BrowseFileCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="6,0,0,0"
                        Height="36"
                        ToolTip="Browse Files">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Browse" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Drag and Drop Zone -->
            <Border Grid.Row="2"
                    x:Name="DropZone"
                    AllowDrop="True"
                    Drop="DropZone_Drop"
                    Background="{DynamicResource MaterialDesignBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="8"
                    MinHeight="80"
                    Cursor="Hand">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Command="{Binding BrowseFileCommand}"
                            Style="{StaticResource MaterialDesignFloatingActionButton}"
                            Width="36" 
                            Height="36"
                            ToolTip="Click or drag files here"
                            Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                    </Button>

                    <TextBlock Text="Drag and drop files here" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" 
                               Foreground="{DynamicResource MaterialDesignBody}"/>

                    <TextBlock Text="or click above to select" 
                               FontSize="10" 
                               HorizontalAlignment="Center" 
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                </StackPanel>
            </Border>
        </Grid>
    </materialDesign:Card>
</UserControl>